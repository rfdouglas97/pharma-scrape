# Local dev defaults match docker-compose.yml; override for Supabase in prod.
DATABASE_URL=postgresql+psycopg://pipeline:pipeline@localhost:5433/pipeline_intel

# Artifact storage: "local" (filesystem, dev) or "s3" (Supabase Storage / R2, prod)
ARTIFACT_BACKEND=local
ARTIFACT_LOCAL_DIR=./artifacts
# ARTIFACT_S3_ENDPOINT=
# ARTIFACT_S3_BUCKET=raw-artifacts
# ARTIFACT_S3_ACCESS_KEY=
# ARTIFACT_S3_SECRET_KEY=

# Anthropic — used from M1 (extraction) onward
# ANTHROPIC_API_KEY=

# Firecrawl (optional) — web-search resolver fallback + JS-render scrape fallback.
# Unset = those fallbacks no-op gracefully. Get a key at firecrawl.dev.
# FIRECRAWL_API_KEY=

# Crawler identity (good-citizen scraping)
CRAWLER_USER_AGENT=PipelineIntelBot/0.1 (+contact: ryanfdoug@gmail.com)
CRAWLER_DELAY_SECONDS=1.0
